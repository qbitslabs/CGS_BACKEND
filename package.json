{
  "name": "cgs-backend",
  "version": "1.0.0",
  "description": "Clinic Growth System (CGS) - Multi-Tenant Healthcare Backend",
  "main": "dist/server.js",
  "scripts": {
    "free-port": "tsx scripts/free-port.ts",
    "dev": "tsx scripts/free-port.ts && tsx watch src/server.ts",
    "dev:watch": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "worker": "tsx src/workers/job.worker.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:cleanup": "tsx scripts/cleanup-test-data.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.19.43",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pdfkit": "^0.20.2",
    "prisma": "^5.19.1",
    "typescript": "^5.5.4",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.1"
  }
}
