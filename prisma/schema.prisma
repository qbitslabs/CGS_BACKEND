// CGS clinic PostgreSQL schema: staff, catalog, visits, billing, WhatsApp threads.
// Source of truth for the clinic API. The AI service uses a separate Postgres.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// ENUMS
// -----------------------------------------------------------------------------

enum UserRole {
  DOCTOR
  EMPLOYEE
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum AdminRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  SUPPORT_ADMIN
  BILLING_ADMIN
}

enum AdminStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ClinicStatus {
  PROVISIONING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum SubscriptionTier {
  STARTER
  GROWTH
  ENTERPRISE
  CUSTOM
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
  EXPIRED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  APPOINTMENT_REQUESTED
  BOOKED
  CONVERTED
  LOST
}

enum LeadSource {
  WHATSAPP
  WEBSITE
  GOOGLE_AD
  INSTAGRAM
  WALK_IN
  REFERRAL
}

enum LeadIntent {
  HIGH
  MEDIUM
  LOW
}

enum PatientStatus {
  ACTIVE
  INACTIVE
  PENDING_FOLLOWUP
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULED
  NO_SHOW
}

enum ConversationState {
  AI_ACTIVE
  HUMAN_ACTIVE
  HANDOFF_PENDING
  CLOSED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageSenderType {
  PATIENT
  AI
  USER
  SYSTEM
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum WhatsappEventStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  VOID
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum SubscriptionInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  PARTIALLY_PAID
  OVERDUE
  VOID
}

enum SubscriptionPaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum UsageType {
  AI
  WHATSAPP
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  RETRYING
  CANCELLED
}

enum NotificationType {
  NEW_LEAD
  NEW_CONVERSATION
  HUMAN_HANDOFF
  APPOINTMENT_REMINDER
  APPOINTMENT_CHANGE
  SYSTEM_NOTIFICATION
}

enum AiEntityType {
  CLINIC
  CHATBOT
  ECOMMERCE
  RESTAURANT
  EDUCATION
  REAL_ESTATE
}

enum AiOperationType {
  CONVERSATION_RESPONSE
  SUMMARY_ADDON
  SUMMARY_MERGE
  SUMMARY_REBUILD
  TOOL_EXECUTION
}

enum SummaryStatus {
  READY
  PROCESSING
  FAILED
}

enum SummaryTriggerReason {
  INACTIVITY
  MANUAL
  CRASH_RECOVERY
  CONVERSATION_CLOSE
  TOKEN_THRESHOLD
}

enum SummaryAddonType {
  PATIENT_PREFERENCE
  APPOINTMENT_PREFERENCE
  SERVICE_INTEREST
  PATIENT_INTENT
  IMPORTANT_CONTEXT
  PATIENT_CONCERN
  COMMUNICATION_PREFERENCE
  FOLLOW_UP_REQUIRED
  HUMAN_HANDOFF
  BOOKING_CONTEXT
  OTHER
}

enum SummaryAddonStatus {
  PENDING
  PROCESSING
  MERGED
  FAILED
  DISCARDED
}

// -----------------------------------------------------------------------------
// CORE PLATFORM & MULTI-TENANCY MODELS
// -----------------------------------------------------------------------------

model Clinic {
  id                    String                @id @default(uuid()) @db.Uuid
  name                  String
  slug                  String?               @unique
  landingPageId         String?               @unique @map("landing_page_id")
  status                ClinicStatus          @default(PROVISIONING)
  phone                 String?
  email                 String?
  address               String?
  city                  String?
  state                 String?
  postalCode            String?               @map("postal_code")
  gstin                 String?
  website               String?
  description           String?
  logoUrl               String?               @map("logo_url")
  workingDays           String[]              @default(["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]) @map("working_days")
  openingTime           String?               @default("09:00") @map("opening_time")
  closingTime           String?               @default("19:00") @map("closing_time")
  workingHours          String?               @map("working_hours")
  timezone              String                @default("Asia/Kolkata")
  currency              String                @default("INR")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  users                 User[]
  doctors               Doctor[]
  doctorServices        DoctorService[]
  doctorSchedules       DoctorSchedule[]
  doctorAvailabilities  DoctorAvailability[]
  services              Service[]
  leads                 Lead[]
  patients              Patient[]
  appointments          Appointment[]
  conversations         Conversation[]
  messages              Message[]
  whatsappAccounts      WhatsappAccount[]
  whatsappEvents        WhatsappEvent[]
  invoices              Invoice[]
  payments              Payment[]
  paymentAuthorizations PaymentAuthorization[]
  cgsSubscriptions      CgsSubscription[]
  subscriptionInvoices  SubscriptionInvoice[]
  subscriptionPayments  SubscriptionPayment[]
  paymentMethods        PaymentMethodRecord[]
  metaCampaigns         MetaCampaign[]
  metaCampaignMetrics   MetaCampaignMetric[]
  metaCreatives         MetaCreative[]
  metaCreativeMetrics   MetaCreativeMetric[]
  whatsappUsage         WhatsAppUsage[]
  notifications         Notification[]
  auditLogs             AuditLog[]
  jobs                  Job[]
  aiConfig              EntityAiConfig?
  aiUsage               AiUsage[]
  conversationSummaries ConversationSummary[]
  conversationSummaryAddons ConversationSummaryAddon[]
  landingPage           ClinicLandingPage?
  workflowConfig        ClinicWorkflowConfig?

  @@index([status])
  @@index([createdAt])
  @@index([landingPageId])
  @@map("clinics")
}

model AdminUser {
  id                    String                @id @default(uuid()) @db.Uuid
  email                 String                @unique
  passwordHash          String                @map("password_hash")
  name                  String
  role                  AdminRole             @default(PLATFORM_ADMIN)
  status                AdminStatus           @default(ACTIVE)
  permissions           String[]              @default([])
  lastLoginAt           DateTime?             @map("last_login_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  @@map("admin_users")
}

model User {
  id                    String                @id @default(uuid()) @db.Uuid
  clinicId              String                @map("clinic_id") @db.Uuid
  email                 String
  passwordHash          String?               @map("password_hash")
  firstName             String                @map("first_name")
  lastName              String?               @map("last_name")
  title                 String?
  phone                 String?
  role                  UserRole              @default(EMPLOYEE)
  status                UserStatus            @default(ACTIVE)
  lastLoginAt           DateTime?             @map("last_login_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  clinic                Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor                Doctor?
  appointmentsCreated   Appointment[]         @relation("AppointmentCreatedBy")
  invoicesCreated       Invoice[]             @relation("InvoiceCreatedBy")
  paymentsCollected     Payment[]             @relation("PaymentCollectedBy")
  notifications         Notification[]
  auditLogs             AuditLog[]

  @@unique([clinicId, email])
  @@index([clinicId, role])
  @@index([clinicId, status])
  @@map("users")
}

model Doctor {
  id                    String                @id @default(uuid()) @db.Uuid
  clinicId              String                @map("clinic_id") @db.Uuid
  userId                String                @unique @map("user_id") @db.Uuid
  specialization        String?
  registrationNo        String?               @map("registration_no")
  qualification         String?
  experienceYears       Int?                  @map("experience_years")
  consultationFee       Decimal?              @map("consultation_fee") @db.Decimal(12, 2)
  availabilityDays      String[]              @default(["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"]) @map("availability_days")
  availabilityHours     String?               @default("09:00 AM - 07:00 PM") @map("availability_hours")
  isActive              Boolean               @default(true) @map("is_active")
  isPrimary             Boolean               @default(false) @map("is_primary")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  clinic                Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  appointments          Appointment[]
  doctorServices        DoctorService[]
  schedules             DoctorSchedule[]
  availabilities        DoctorAvailability[]
  conversations         Conversation[]
  aiUsage               AiUsage[]
  treatedInvoices       Invoice[]             @relation("InvoiceTreatingDoctor")

  @@index([clinicId, isActive])
  @@map("doctors")
}

model DoctorService {
  id                    String                @id @default(uuid()) @db.Uuid
  clinicId              String                @map("clinic_id") @db.Uuid
  doctorId              String                @map("doctor_id") @db.Uuid
  serviceId             String                @map("service_id") @db.Uuid
  customPrice           Decimal?              @map("custom_price") @db.Decimal(12, 2)
  customDurationMinutes Int?                  @map("custom_duration_minutes")
  isActive              Boolean               @default(true) @map("is_active")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  clinic                Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor                Doctor                @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  service               Service               @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([doctorId, serviceId])
  @@index([clinicId, doctorId])
  @@index([serviceId])
  @@map("doctor_services")
}

model DoctorSchedule {
  id                    String                @id @default(uuid()) @db.Uuid
  clinicId              String                @map("clinic_id") @db.Uuid
  doctorId              String                @map("doctor_id") @db.Uuid
  dayOfWeek             String                @map("day_of_week") // e.g. MONDAY, TUESDAY or 0-6
  startTime             String                @map("start_time")   // e.g. "09:00"
  endTime               String                @map("end_time")     // e.g. "17:00"
  breakStartTime        String?               @map("break_start_time")
  breakEndTime          String?               @map("break_end_time")
  slotDurationMinutes   Int                   @default(30) @map("slot_duration_minutes")
  maxBookingsPerSlot    Int                   @default(1) @map("max_bookings_per_slot")
  isActive              Boolean               @default(true) @map("is_active")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  clinic                Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor                Doctor                @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([clinicId, doctorId, dayOfWeek])
  @@map("doctor_schedules")
}

model DoctorAvailability {
  id                    String                @id @default(uuid()) @db.Uuid
  clinicId              String                @map("clinic_id") @db.Uuid
  doctorId              String                @map("doctor_id") @db.Uuid
  date                  DateTime              @db.Date
  startTime             String                @map("start_time")
  endTime               String                @map("end_time")
  isAvailable           Boolean               @default(true) @map("is_available")
  reason                String?
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  clinic                Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor                Doctor                @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([clinicId, doctorId, date])
  @@map("doctor_availability")
}

model Service {
  id                    String                @id @default(uuid()) @db.Uuid
  clinicId              String                @map("clinic_id") @db.Uuid
  name                  String
  description           String?
  durationMinutes       Int                   @default(30) @map("duration_minutes")
  price                 Decimal               @db.Decimal(12, 2)
  category              String?               @default("General")
  isActive              Boolean               @default(true) @map("is_active")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  clinic                Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctorServices        DoctorService[]
  appointmentServices   AppointmentService[]
  invoiceItems          InvoiceItem[]

  @@unique([clinicId, name])
  @@index([clinicId, isActive])
  @@map("services")
}

// -----------------------------------------------------------------------------
// CRM & PATIENT MODELS
// -----------------------------------------------------------------------------

model Lead {
  id                    String                @id @default(uuid()) @db.Uuid
  clinicId              String                @map("clinic_id") @db.Uuid
  name                  String
  phone                 String
  email                 String?
  source                LeadSource            @default(WHATSAPP)
  status                LeadStatus            @default(NEW)
  score                 Int                   @default(50)
  interestedService     String?               @map("interested_service")
  preferredDoctor       String?               @map("preferred_doctor")
  howHeardAboutDoctor   String?               @map("how_heard_about_doctor")
  intent                LeadIntent            @default(MEDIUM)
  notes                 String?
  assignedToUserId      String?               @map("assigned_to_user_id") @db.Uuid
  convertedPatientId    String?               @unique @map("converted_patient_id") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  clinic                Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  convertedPatient      Patient?              @relation(fields: [convertedPatientId], references: [id], onDelete: SetNull)
  conversations         Conversation[]
  activities            LeadActivity[]

  @@index([clinicId, status])
  @@index([clinicId, phone])
  @@index([clinicId, createdAt])
  @@map("leads")
}

model LeadActivity {
  id                    String                @id @default(uuid()) @db.Uuid
  leadId                String                @map("lead_id") @db.Uuid
  type                  String                // 'created', 'status_change', 'message', 'assignment', 'appointment', 'note'
  title                 String
  description           String
  actor                 String
  createdAt             DateTime              @default(now()) @map("created_at")

  lead                  Lead                  @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model Patient {
  id                    String                @id @default(uuid()) @db.Uuid
  clinicId              String                @map("clinic_id") @db.Uuid
  name                  String
  phone                 String
  email                 String?
  gender                Gender                @default(OTHER)
  age                   Int?
  dateOfBirth           DateTime?             @map("date_of_birth")
  bloodGroup            String?               @map("blood_group")
  address               String?
  allergies             String[]              @default([])
  medicalHistoryNotes   String?               @map("medical_history_notes")
  status                PatientStatus         @default(ACTIVE)
  leadId                String?               @unique @map("lead_id") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  clinic                Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  lead                  Lead?
  appointments          Appointment[]
  conversations         Conversation[]
  invoices              Invoice[]
  payments              Payment[]
  activities            PatientActivity[]

  @@index([clinicId, phone])
  @@index([clinicId, status])
  @@index([clinicId, createdAt])
  @@map("patients")
}

model PatientActivity {
  id                    String                @id @default(uuid()) @db.Uuid
  patientId             String                @map("patient_id") @db.Uuid
  type                  String                // 'appointment', 'note', 'conversation', 'profile_update'
  title                 String
  description           String
  actor                 String
  createdAt             DateTime              @default(now()) @map("created_at")

  patient               Patient               @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId, createdAt])
  @@map("patient_activities")
}

// -----------------------------------------------------------------------------
// APPOINTMENTS & SCHEDULING MODELS
// -----------------------------------------------------------------------------

model Appointment {
  id                    String                @id @default(uuid()) @db.Uuid
  clinicId              String                @map("clinic_id") @db.Uuid
  patientId             String                @map("patient_id") @db.Uuid
  doctorId              String?               @map("doctor_id") @db.Uuid
  service               String?
  status                AppointmentStatus     @default(SCHEDULED)
  startsAt              DateTime              @map("starts_at")
  endsAt                DateTime              @map("ends_at")
  durationMinutes       Int                   @default(30) @map("duration_minutes")
  notes                 String?
  createdByUserId       String?               @map("created_by_user_id") @db.Uuid
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  clinic                Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patient               Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  doctor                Doctor?               @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  createdBy             User?                 @relation("AppointmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  services              AppointmentService[]

  @@index([clinicId, startsAt])
  @@index([clinicId, doctorId, startsAt])
  @@index([clinicId, patientId])
  @@map("appointments")
}

model AppointmentService {
  appointmentId         String                @map("appointment_id") @db.Uuid
  serviceId             String                @map("service_id") @db.Uuid

  appointment           Appointment           @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service               Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([appointmentId, serviceId])
  @@map("appointment_services")
}

// -----------------------------------------------------------------------------
// WHATSAPP & CONVERSATION MODELS
// -----------------------------------------------------------------------------

model WhatsappAccount {
  id                    String                @id @default(uuid()) @db.Uuid
  clinicId              String                @map("clinic_id") @db.Uuid
  phoneNumberId         String                @unique @map("phone_number_id")
  businessAccountId     String?               @map("business_account_id")
  displayPhoneNumber    String?               @map("display_phone_number")
  accessTokenEncrypted  String                @map("access_token_encrypted")
  apiVersion            String?               @default("v19.0") @map("api_version")
  webhookUrl            String?               @map("webhook_url")
  verifyToken           String?               @map("verify_token")
  webhookStatus         String?               @default("PENDING") @map("webhook_status")
  messageTemplates      Json?                 @map("message_templates")
  qualityRating         String?               @default("High") @map("quality_rating")
  isActive              Boolean               @default(true) @map("is_active")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  clinic                Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  conversations         Conversation[]
  events                WhatsappEvent[]
  messages              Message[]
  usage                 WhatsAppUsage[]

  @@index([clinicId, isActive])
  @@map("whatsapp_accounts")
}

model WhatsappEvent {
  id                    String                @id @default(uuid()) @db.Uuid
  clinicId              String?               @map("clinic_id") @db.Uuid
  whatsappAccountId     String?               @map("whatsapp_account_id") @db.Uuid
  providerEventId       String                @unique @map("provider_event_id")
  eventType             String                @map("event_type")
  payload               Json
  status                WhatsappEventStatus   @default(RECEIVED)
  errorMessage          String?               @map("error_message")
  processedAt           DateTime?             @map("processed_at")
  createdAt             DateTime              @default(now()) @map("created_at")

  clinic                Clinic?               @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  whatsappAccount       WhatsappAccount?      @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)

  @@index([clinicId, createdAt])
  @@map("whatsapp_events")
}

model Conversation {
  id                    String                @id @default(uuid()) @db.Uuid
  clinicId              String                @map("clinic_id") @db.Uuid
  patientId             String?               @map("patient_id") @db.Uuid
  leadId                String?               @map("lead_id") @db.Uuid
  whatsappAccountId     String?               @map("whatsapp_account_id") @db.Uuid
  participantName       String                @map("participant_name")
  participantPhone      String                @map("participant_phone")
  state                 ConversationState     @default(AI_ACTIVE)
  unreadCount           Int                   @default(0) @map("unread_count")
  assignedToUserId      String?               @map("assigned_to_user_id") @db.Uuid
  doctorId              String?               @map("doctor_id") @db.Uuid
  serviceInterested     String?               @map("service_interested")
  handoffReason         String?               @map("handoff_reason")
  internalNotes         String?               @map("internal_notes")
  lastMessageText       String?               @map("last_message_text")
  lastMessageAt         DateTime?             @map("last_message_at")
  lastActivityAt        DateTime?             @map("last_activity_at")
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  clinic                Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  doctor                Doctor?               @relation(fields: [doctorId], references: [id], onDelete: SetNull)
  patient               Patient?              @relation(fields: [patientId], references: [id], onDelete: SetNull)
  lead                  Lead?                 @relation(fields: [leadId], references: [id], onDelete: SetNull)
  whatsappAccount       WhatsappAccount?      @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  messages              Message[]
  summary               ConversationSummary?
  summaryVersions       ConversationSummaryVersion[]
  summaryAddons         ConversationSummaryAddon[]
  aiUsage               AiUsage[]

  @@index([clinicId, state])
  @@index([clinicId, lastMessageAt])
  @@index([clinicId, lastActivityAt])
  @@index([clinicId, doctorId, lastActivityAt])
  @@index([clinicId, participantPhone])
  @@map("conversations")
}

model Message {
  id                    String                @id @default(uuid()) @db.Uuid
  clinicId              String                @map("clinic_id") @db.Uuid
  conversationId        String                @map("conversation_id") @db.Uuid
  whatsappAccountId     String?               @map("whatsapp_account_id") @db.Uuid
  direction             MessageDirection
  senderType            MessageSenderType
  senderName            String                @map("sender_name")
  content               String?
  mediaUrl              String?               @map("media_url")
  mediaType             String?               @map("media_type")
  providerMessageId     String?               @unique @map("provider_message_id")
  status                MessageStatus         @default(PENDING)
  isAiGenerated         Boolean               @default(false) @map("is_ai_generated")
  createdAt             DateTime              @default(now()) @map("created_at")

  clinic                Clinic                @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  conversation          Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  whatsappAccount       WhatsappAccount?      @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  summaryAddons         ConversationSummaryAddon[]
  aiUsage               AiUsage[]

  @@index([clinicId, conversationId, createdAt])
  @@map("messages")
}

// -----------------------------------------------------------------------------
// PATIENT BILLING & TREATMENT INVOICES
// -----------------------------------------------------------------------------

model Invoice {
  id                    String                @id @default(uuid()) @db.Uuid
  clinicId              String                @map("clinic_id") @db.Uuid
  patientId             String                @map("patient_id") @db.Uuid
  invoiceNumber         String                @map("invoice_number")
  service               String?
  status                InvoiceStatus         @default(DRAFT)
  subtotal              Decimal               @db.Decimal(12, 2)
  discount              Decimal               @default(0) @db.Decimal(12, 2)
  tax                   Decimal               @default(0) @db.Decimal(12, 2)
  total                 Decimal               @db.Decimal(12, 2)
  amountPaid            Decimal               @default(0) @map("amount_paid") @db.Decimal(12, 2)
  amountDue             Decimal               @default(0) @map("amount_due") @db.Decimal(12, 2)
  paymentMethod         PaymentMethod?        @map("payment_method")
  notes                 String?
  createdByUserId       String?               @map("created_by_user_id") @db.Uuid
